{% extends 'layout/public.html.twig' %}
{% block title %}Search bills{% endblock %}
{% do page({show_page_header: false}) %}
{% block content %}
{% set sc = survos_stimulus('search-bundle', 'instantsearch') %}
<div class="container-xl py-4" {{ stimulus_controller(sc, {
    endpoint: endpoint|default(path('survos_search_instant')),
    name: name,
    template: path('app_bill_search_template'),
    sorts: sorts
}) }}>
    <h1>Search Virginia bills</h1>
    <p><a class="btn btn-primary" href="{{ path('app_bill_chat') }}">Chat about 2026 bills</a></p>
    {% if app.debug %}
        {% set current = app.request.query.all[name]|default({}) %}
        <nav class="nav nav-pills mb-3" aria-label="Search backend" data-controller="bill-backend" data-bill-backend-name-value="{{ name }}" data-action="click->bill-backend#switch">
            {% set engines = {postgres: 'app_bill_pg', es: 'app_bill_es'} %}
            {% for engine, searchName in engines %}
                <a data-search-name="{{ searchName }}" class="nav-link{{ name == searchName ? ' active' : '' }}" href="{{ path('app_bill_compare', {backend: engine}) }}?{{ {(searchName): current}|url_encode }}">{{ engine == 'es' ? 'Elasticsearch' : (engine == 'postgres' ? 'PostgreSQL' : 'DuckDB') }}</a>
            {% endfor %}
        </nav>
        <p class="text-secondary">{{ backendLabel|default('DuckDB FTS / BM25') }}</p>
    {% endif %}
    <p class="text-secondary">Search legislation by title, summary, full text, or patron.</p>
    <div class="mb-4" {{ stimulus_target(sc, 'query') }}></div>
    <div class="alert alert-danger" role="alert" hidden {{ stimulus_target(sc, 'error') }}></div>
    <div class="row g-4">
        <aside class="col-12 col-md-3" aria-label="Search filters">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h3 mb-0">Refine results</h2>
                <div {{ stimulus_target(sc, 'clear') }}></div>
            </div>
            {% for field, label in facets %}
                <section class="mb-4">
                    <h3 class="h4">{{ label }}</h3>
                    <div data-field="{{ field }}" data-label="{{ label }}" {{ stimulus_target(sc, 'facet') }}></div>
                </section>
            {% endfor %}
        </aside>
        <main class="col-12 col-md-9">
            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                <div aria-live="polite" {{ stimulus_target(sc, 'stats') }}></div>
                <div aria-label="Sort results" {{ stimulus_target(sc, 'sort') }}></div>
            </div>
            <div class="mb-3" {{ stimulus_target(sc, 'current') }}></div>
            <div class="py-5 text-center text-secondary" style="min-height:18rem" role="status" aria-live="polite" hidden {{ stimulus_target(sc, 'loading') }}>
                <div class="spinner-border text-primary mb-3" aria-hidden="true"></div>
                <div>Searching…</div>
            </div>
            <div {{ stimulus_target(sc, 'hits') }}></div>
            <div class="mt-4" {{ stimulus_target(sc, 'pagination') }}></div>
        </main>
    </div>
</div>
{% endblock %}
