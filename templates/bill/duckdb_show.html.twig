{% extends '@SurvosTabler/layout/base.html.twig' %}
{% block title %}{{ bill.number|upper }} · DuckDB{% endblock %}
{% block content %}
<div class="container-xl py-4">
    <a href="{{ path('app_bill_search') }}">← Bill search</a>
    <div class="subheader mt-3">{{ bill.year }} · {{ bill.chamber }} · {{ bill.number|upper }}</div>
    <h1>{{ bill.catch_line }}</h1><p>{{ bill.patron_name_formatted }} · {{ bill.status }}</p>
    <div class="card mb-3"><div class="card-body"><h2>Summary</h2>{{ bill.summary|default('')|sanitize_html('bill_text') }}</div></div>
    <div class="card mb-3"><div class="card-body"><h2>Text versions</h2><ul>{% for version in bill.text|default([]) %}<li>{{ version.date }} · {{ version.number }}{% if version.pdf_url is defined %} · <a href="{{ version.pdf_url }}" rel="noopener noreferrer">Source PDF</a>{% endif %}</li>{% endfor %}</ul></div></div>
    <div class="card"><div class="card-body"><h2>Full text</h2>{{ bill.full_text|default('')|sanitize_html('bill_text') }}</div></div>
</div>
{% endblock %}
