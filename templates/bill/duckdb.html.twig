{% extends '@SurvosTabler/layout/base.html.twig' %}
{% block title %}DuckDB bill search{% endblock %}
{% block content %}
<div class="container-xl py-4">
    <div class="d-flex justify-content-between align-items-center mb-3"><h1>Virginia bills · DuckDB</h1><a href="{{ path('app_bill_search') }}" class="btn">Elasticsearch search</a></div>
    <p class="text-secondary">Full-text search over {{ metadata.bills|number_format }} bills and resolutions. Read-only snapshot · no Elasticsearch requests.</p>
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-6"><label for="q" class="form-label">Search bills</label><input id="q" name="q" value="{{ query }}" class="form-control" maxlength="300" placeholder="Try minimum wage, schools, or a bill number"></div>
        <div class="col-md-2"><label for="year" class="form-label">Session year</label><select id="year" name="year" class="form-select"><option value="">All years</option>{% for item in metadata.years|reverse %}<option value="{{ item.year }}" {{ year == item.year ? 'selected' }}>{{ item.year }}</option>{% endfor %}</select></div>
        <div class="col-md-2"><label for="chamber" class="form-label">Chamber</label><select id="chamber" name="chamber" class="form-select"><option value="">Both chambers</option>{% for value in ['house', 'senate'] %}<option value="{{ value }}" {{ chamber == value ? 'selected' }}>{{ value|title }}</option>{% endfor %}</select></div>
        <div class="col-md-2 align-self-end"><button class="btn btn-primary w-100">Search</button></div>
    </form>
    <p aria-live="polite"><strong>{{ result.total|number_format }} results</strong> · {{ result.elapsedMs }} ms including connection ({{ result.openMs }} ms)</p>
    <div class="row g-3">{% for hit in result.hits %}<div class="col-12"><article class="card"><div class="card-body">
        <div class="subheader">{{ hit.year }} · {{ hit.chamber }} · {{ hit.number|upper }}</div>
        <h2 class="h3 mt-2"><a href="{{ path('app_bill_duckdb_show', {id: hit.id}) }}">{{ hit.catch_line }}</a></h2>
        <p>{{ hit.summary|slice(0, 400) }}{{ hit.summary|length > 400 ? '…' }}</p>
        <div class="text-secondary">{{ hit.patron_name }} · {{ hit.status }}</div>
    </div></article></div>{% else %}<p>No matching bills.</p>{% endfor %}</div>
    <nav class="d-flex justify-content-between my-4" aria-label="Pagination">
        {% if result.page > 1 %}<a class="btn" href="{{ path('app_bill_duckdb', {q: query, year: year, chamber: chamber, page: result.page - 1}) }}">Previous</a>{% endif %}
        <span>Page {{ result.page }} of {{ result.pages }}</span>
        {% if result.page < result.pages %}<a class="btn" href="{{ path('app_bill_duckdb', {q: query, year: year, chamber: chamber, page: result.page + 1}) }}">Next</a>{% endif %}
    </nav>
</div>
{% endblock %}
