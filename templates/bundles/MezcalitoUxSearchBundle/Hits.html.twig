{% block content %}
    <div {{ attributes.defaults({class: 'ux-search-hits'}) }}>
        {% if results.hits|length > 0 %}
            <div class="ux-search-hits__list list-group list-group-flush">
                {% for resultHit in results.hits %}
                    {% block hit %}
                        {% set hitTemplate = search.hitTemplate is defined ? search.hitTemplate : null %}
                        {% if hitTemplate %}
                            {{ include(hitTemplate, {hit: resultHit.data, resultHit: resultHit}, with_context = false) }}
                        {% else %}
                            <div class="ux-search-hits__item" style="max-width: 100%; overflow: auto;">
                                <pre style="font-family: monospace">{{ resultHit.data|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                            </div>
                        {% endif %}
                    {% endblock %}
                {% endfor %}
            </div>
        {% else %}
            {% block noResult %}
                <div class="ux-search-hits__no-result">{{ 'no_result'|trans(domain='mezcalito_ux_search') }}</div>
            {% endblock %}
        {% endif %}
    </div>
{% endblock %}
