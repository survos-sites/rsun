<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#126dcc"><meta name="apple-mobile-web-app-capable" content="yes">
    <title>VA Bills · Ask about Virginia</title>
    <link rel="manifest" href="/vabills.webmanifest">
    {{ importmap('app') }}
</head>
<body class="mobile-bills" data-controller="bill-chat" data-action="keydown->bill-chat#keydown">
<header class="mobile-header">
    <a href="{{ path('app_bill_chat_mobile') }}" class="mobile-brand">VA Bills <span>Virginia legislation, in conversation</span></a>
    <details class="mobile-settings"><summary aria-label="Session and conversation settings">Settings</summary>
        <div>
        <form method="get" action="{{ path('app_bill_chat_mobile') }}"><label for="session-year">Session</label><select id="session-year" name="year" class="form-select">{% for y in 2026..2023 %}<option value="{{ y }}" {{ year == y ? 'selected' }}>{{ y }}</option>{% endfor %}</select><button class="btn btn-primary mt-2">Use session</button></form>
        <form method="post" action="{{ path('app_bill_chat_clear', {year: year, bill: billId, mobile: 1}) }}" class="mt-3"><input type="hidden" name="_token" value="{{ csrf_token(key ~ '_clear') }}"><button class="btn btn-outline-secondary">Clear conversation</button></form>
        <p class="mt-3 mb-0">Add to your home screen from your browser’s Share or menu button. Internet required.</p>
        </div>
    </details>
</header>
<main class="mobile-history" data-bill-chat-target="history" aria-label="Conversation">
    {% if bill %}<section class="mobile-context"><span class="subheader">{{ year }} · {{ bill.number|upper }}</span><h1>{{ bill.catchLine }}</h1><p>{{ bill.patronNameFormatted }}</p><div>{{ bill.summary|sanitize_html('bill_text') }}</div><a href="{{ path('app_bill_show', {id: bill.id}) }}">Read this bill</a></section>
    {% else %}<section class="mobile-intro"><div class="subheader">{{ year }} Virginia General Assembly</div><h1>What matters to<br>your community?</h1><p>Ask about schools, farms, housing, and more. Follow up. Read the bill behind the answer.</p></section>{% endif %}
    {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
    {% for message in turns %}<article class="mobile-message mobile-message--{{ message.role }}"><div class="subheader mb-2">{{ message.role == 'assistant' ? 'VA Bills' : 'You' }}</div><div class="{{ message.role == 'assistant' ? 'bill-chat-answer' : 'bill-chat-question' }}">{% if message.role == 'assistant' %}{{ message.text|chat_markdown }}{% else %}{{ message.text }}{% endif %}</div></article>{% endfor %}
    {% if not turns %}<p class="mobile-note">Answers describe archived bills and their status, not a check of current law. Budget line items are not separately indexed.</p>{% endif %}
</main>
<div class="mobile-composer">
    {% include '@SurvosAiChat/widget.html.twig' with {
        messages: [], action: path('app_bill_chat_mobile', {year: year, bill: billId}), token: csrf_token(key),
        samples: turns ? [] : (bill ? [{label: 'Explain this bill', question: 'Explain this bill and what it changes.'}] : [
            {label: 'School buildings', question: 'How could communities pay to repair school buildings? Who introduced those proposals, and did they pass?'},
            {label: 'Farms + solar', question: 'What about solar panels on working farms? Can farmers keep farming on the same land?'},
            {label: 'Small farms', question: 'What did lawmakers propose to support small farms in this session?'}
        ])
    } %}
    <p class="mobile-hint">Enter to send · Shift+Enter for a new line · Check the citations</p>
</div>
<nav class="mobile-nav" aria-label="VA Bills"><a href="{{ path('app_bill_chat_mobile', {year: year}) }}" aria-current="page">Chat</a><a href="{{ path('app_bill_search') }}">Search bills</a><a href="{{ path('app_bill_mcp_help') }}">Your AI agent</a></nav>
</body>
</html>
