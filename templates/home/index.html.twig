{% extends 'layout/public.html.twig' %}
{% block title %}VA Bills · Follow the issues. Understand the bills.{% endblock %}
{% block content %}
<div class="va-home">
    <section class="va-hero">
        <div class="va-eyebrow">YOUR COMMONWEALTH. YOUR QUESTIONS.</div>
        <h1>What’s happening<br>with the issues<br><em>you care about?</em></h1>
        <p class="va-intro">School repairs. Rural healthcare. The cost of housing.<br>Find the Virginia bills behind the issues—and understand what they would change.</p>
        <div class="va-hero-actions"><a class="va-button" href="{{ path('app_bill_chat') }}">Ask a question <span aria-hidden="true">↗</span></a><a class="va-text-link" href="{{ path('app_bill_search') }}">Explore the bills <span aria-hidden="true">→</span></a></div>
    </section>
    <section class="va-discover" aria-labelledby="find-heading">
        <div class="va-eyebrow">START WITH WHAT YOU KNOW</div>
        <h2 id="find-heading">An issue. A name.<br>A bill number.</h2>
        <form action="{{ path('app_bill_search') }}" method="get" class="va-search-form">
            <label for="home-query">Search Virginia bills</label>
            <div><input id="home-query" name="app_bill_es[query]" type="search" placeholder="School funding, healthcare, HB755…" required><button type="submit" aria-label="Search bills">→</button></div>
        </form>
        <div class="va-topics"><span>Try an issue</span>{% for label, query in {'Schools': 'school', 'Agriculture': 'agriculture', 'Healthcare': 'healthcare', 'Housing': 'housing'} %}<a href="{{ path('app_bill_search', {app_bill_es: {query: query}}) }}">{{ label }}</a>{% endfor %}</div>
        <p class="va-small">Filter by session, sponsor, or status. Read the text behind the headline.</p>
    </section>
    <section class="va-conversation" aria-labelledby="conversation-heading">
        <div><div class="va-eyebrow">YOU DON’T NEED TO SPEAK LEGISLATIVE</div><h2 id="conversation-heading">Start with a question.<br>Then ask another.</h2><p>Explore a topic in your own words. Find out what a bill proposes, who introduced it, and where it stands—with links back to the source.</p><a class="va-text-link" href="{{ path('app_bill_chat') }}">Start a conversation →</a></div>
        <div class="va-question-list" aria-label="Questions you can ask"><p>“What would help schools pay for repairs?”</p><p>“Did any of those bills pass?”</p><p>“Who introduced the ones that didn’t?”</p><span>Follow your curiosity. Follow the sources.</span></div>
    </section>
    <section class="va-agent" aria-labelledby="agent-heading"><div><div class="va-eyebrow">BRING YOUR OWN ASSISTANT</div><h2 id="agent-heading">Your AI. Virginia’s bills.</h2><p>Already use Claude or ChatGPT? Connect VA Bills so your assistant can find legislation and read the sources with you.</p></div><a class="va-button va-button-light" href="{{ path('app_bill_mcp_help') }}">Connect VA Bills <span aria-hidden="true">↗</span></a></section>
</div>
{% endblock %}
