{
    "name": "VA Bills",
    "description": "Search and discuss Virginia legislation with cited sources and MCP access",
    "keywords": [
        "php",
        "symfony"
    ],
    "repository": "https://github.com/survos-sites/rsun",
    "scripts": {
        "dokku": {
            "predeploy": "bin/console importmap:install && bin/console asset-map:compile && bin/console doctrine:migrations:migrate -n --allow-no-migration",
            "postdeploy": "bin/console about"
        }
    },
    "image": "gliderlabs/herokuish",
    "buildpacks": [
        {
            "url": "https://github.com/heroku/heroku-buildpack-php.git"
        }
    ],
    "healthchecks": {
        "web": [
            {
                "type": "startup",
                "name": "http",
                "path": "/health",
                "attempts": 5,
                "timeout": 10,
                "wait": 5
            }
        ]
    }
}
